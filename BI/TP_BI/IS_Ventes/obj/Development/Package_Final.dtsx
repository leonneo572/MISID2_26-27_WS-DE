              <properties>
                <property
                  dataType="System.String"
                  description="Specifies the SQL statement used by the component to extract data."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT p.Nom, p.Code AS code_prod,
	f.Code AS code_famille, f.Nom  AS famille,
	sf.Code AS code_sfamille, sf.Nom AS sousfamille
FROM Produit_SA p, Famille_SA f, Sous_Famille_SA sf 
WHERE p.SousFamille_ID = sf.SousFamille_ID AND sf.Famille_ID = f.Famille_ID</property>
